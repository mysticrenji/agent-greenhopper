{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "greenhopper-agent",
  "main": "src/index.ts",
  // Required secrets (set via `wrangler secret put`):
  //   HASS_TOKEN              — Home Assistant long-lived access token
  //   HASS_BASE_URL           — HA base URL as seen from the tunnel
  //   RUN_ACCESS_CLIENT_ID    — CF Access service-token client ID for /run
  //   RUN_ACCESS_CLIENT_SECRET— CF Access service-token client secret for /run
  "compatibility_date": "2025-07-01",
  "compatibility_flags": ["nodejs_compat"],
  // Hourly cron trigger
  "triggers": { "crons": ["0 * * * *"] },
  // VPC Service binding to reach Home Assistant
  "vpc_services": [
    {
      "binding": "HASS",
      "service_id": "01a01f7c-1dd6-7c03-b705-c489bd12c013",
      "remote": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "greenhopper",
      "database_id": "b36bc5b4-77ed-45c3-9c82-b4244c46fc38"
    }
  ],
  // AI Gateway binding for model calls
  "ai": {
    "binding": "AI"
  }
}
